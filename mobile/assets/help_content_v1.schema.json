{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fichacosto.local/schemas/help_content_v1.schema.json",
  "title": "FichaCosto Help Content v1",
  "description": "Contrato común de ayuda offline en español para Flutter y Desktop.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "appVersion", "idioma", "onboarding", "tooltips", "tutoriales", "preguntas_frecuentes", "avisos_contextuales", "datos_inicio"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "appVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "idioma": {"const": "es-CU"},
    "onboarding": {
      "type": "object", "additionalProperties": false, "required": ["pasos"],
      "properties": {"pasos": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"$ref": "#/$defs/onboardingStep"}}}
    },
    "tooltips": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/tooltip"}},
    "tutoriales": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/tutorial"}},
    "preguntas_frecuentes": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/faq"}},
    "avisos_contextuales": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/notice"}},
    "datos_inicio": {
      "type": "object", "additionalProperties": false, "required": ["catalogos", "ficha_demo"],
      "properties": {
        "catalogos": {"type": "object", "additionalProperties": false, "required": ["paladar", "cafeteria"], "properties": {
          "paladar": {"$ref": "#/$defs/sampleCatalog"}, "cafeteria": {"$ref": "#/$defs/sampleCatalog"}
        }},
        "ficha_demo": {"type": "object", "additionalProperties": false, "required": ["nombre", "descripcion", "monedaBase", "partidas"], "properties": {
          "nombre": {"type": "string", "minLength": 1}, "descripcion": {"type": "string"}, "monedaBase": {"enum": ["CUP", "MLC"]},
          "partidas": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["categoria", "descripcion", "cantidad", "unidadMedida", "precioUnitario", "moneda"], "properties": {
            "categoria": {"type": "string"}, "descripcion": {"type": "string"}, "cantidad": {"type": "number", "exclusiveMinimum": 0}, "unidadMedida": {"type": "string"}, "precioUnitario": {"type": "number", "minimum": 0}, "moneda": {"enum": ["CUP", "MLC"]}
          }}
        }}
      }
    }
  }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"},
    "action": {
      "type": "object", "additionalProperties": false, "required": ["tipo"],
      "properties": {"tipo": {"enum": ["siguiente", "ir_a_pantalla", "abrir_tutorial", "ninguna"]}, "target": {"type": "string", "minLength": 1}}
    },
    "onboardingStep": {
      "type": "object", "additionalProperties": false, "required": ["id", "titulo", "cuerpo", "imagen", "accion"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "titulo": {"type": "string", "minLength": 1}, "cuerpo": {"type": "string", "minLength": 1}, "imagen": {"type": "string", "pattern": "^assets/help/"}, "accion": {"$ref": "#/$defs/action"}, "opcional": {"type": "boolean"}}
    },
    "tooltip": {
      "type": "object", "additionalProperties": false, "required": ["titulo", "cuerpo"],
      "properties": {"titulo": {"type": "string", "minLength": 1}, "cuerpo": {"type": "string", "minLength": 1}, "normativa": {"type": "string"}, "tutorialId": {"$ref": "#/$defs/id"}}
    },
    "tutorial": {
      "type": "object", "additionalProperties": false, "required": ["id", "titulo", "pasos"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "titulo": {"type": "string", "minLength": 1}, "resumen": {"type": "string"}, "pasos": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["texto", "imagen"], "properties": {"texto": {"type": "string", "minLength": 1}, "imagen": {"type": "string", "pattern": "^assets/help/"}}}}}
    },
    "faq": {
      "type": "object", "additionalProperties": false, "required": ["id", "pregunta", "respuesta"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "pregunta": {"type": "string", "minLength": 1}, "respuesta": {"type": "string", "minLength": 1}, "tutorialId": {"$ref": "#/$defs/id"}}
    },
    "notice": {
      "type": "object", "additionalProperties": false, "required": ["condicion", "mensaje", "accion", "repetirTrasDias"],
      "properties": {"condicion": {"type": "string", "minLength": 1}, "mensaje": {"type": "string", "minLength": 1}, "accion": {"$ref": "#/$defs/action"}, "repetirTrasDias": {"type": "integer", "minimum": 0, "maximum": 365}, "pantalla": {"type": "string"}}
    },
    "sampleCatalog": {
      "type": "object", "additionalProperties": false, "required": ["titulo", "aviso", "insumos", "tarifas"],
      "properties": {"titulo": {"type": "string"}, "aviso": {"type": "string"}, "insumos": {"type": "array", "minItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["nombre", "unidadMedida", "costoUnitario", "moneda"], "properties": {"nombre": {"type": "string"}, "unidadMedida": {"type": "string"}, "costoUnitario": {"type": "number", "minimum": 0}, "moneda": {"enum": ["CUP", "MLC"]}}}}, "tarifas": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["cargo", "unidadTarifa", "valor", "moneda"], "properties": {"cargo": {"type": "string"}, "unidadTarifa": {"type": "string"}, "valor": {"type": "number", "minimum": 0}, "moneda": {"enum": ["CUP", "MLC"]}}}}
    }
  }
}
}
